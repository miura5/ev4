{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/weeks",
 "title": "weeks/<id>",
 "description": "review text, reflection prompt, calibration, health line, roll-ups",
 "x-ev": {
  "collection": "weeks",
  "class": "Derived",
  "writers": [
   "weekly"
  ],
  "schema": 3,
  "authored": [
   "review",
   "reflection"
  ]
 },
 "$comment": "Shape completed with the weekly pipeline (B-09).",
 "type": "object",
 "properties": {
  "schema": {
   "const": 3
  },
  "writer": {
   "enum": [
    "weekly"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "review": {
   "type": "string"
  },
  "reflection": {
   "type": "string"
  },
  "calibration": {
   "type": "object"
  },
  "health": {
   "type": "object",
   "description": "schema 2 (B-29): the week's run line, and the read-only verify-deploy the weekly ran on its own record",
   "required": [
    "summary"
   ],
   "properties": {
    "summary": {
     "type": "string"
    },
    "verify": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "at",
        "target",
        "green"
       ],
       "properties": {
        "at": {
         "type": "string"
        },
        "target": {
         "enum": [
          "live",
          "staging"
         ]
        },
        "commit": {
         "type": [
          "string",
          "null"
         ]
        },
        "green": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "checked": {
         "type": "integer",
         "minimum": 0
        },
        "differences": {
         "type": "array",
         "maxItems": 30,
         "items": {
          "type": "object",
          "required": [
           "what"
          ],
          "properties": {
           "what": {
            "type": "string"
           },
           "detail": {
            "type": "string"
           }
          }
         }
        },
        "refused": {
         "type": "string"
        }
       }
      }
     ]
    }
   }
  },
  "rollups": {
   "type": "object",
   "properties": {
    "readiness": {
     "description": "B-48 (D-105): readiness per upcoming exam of every active course as of this document (percent solid, active and solid weak spots, accuracy over the last seven days); null on a document written before it",
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "properties": {
         "pctSolid": {
          "anyOf": [
           {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
           },
           {
            "type": "null"
           }
          ]
         },
         "active": {
          "type": "integer",
          "minimum": 0
         },
         "solid": {
          "type": "integer",
          "minimum": 0
         },
         "accuracy7": {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           {
            "type": "null"
           }
          ]
         },
         "answers7": {
          "type": "integer",
          "minimum": 0
         }
        },
        "required": [
         "pctSolid",
         "active",
         "solid",
         "accuracy7",
         "answers7"
        ],
        "additionalProperties": false
       }
      }
     ]
    }
   }
  },
  "study": {
   "type": "object",
   "description": "B-68 (D-116): the week's list and shadow compared (core/study.mjs compareWeek); absent before the shadow existed"
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "date"
 ]
}