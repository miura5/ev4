{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/weeks",
 "title": "weeks/<id>",
 "description": "review text, reflection prompt, calibration, health line, roll-ups",
 "x-ev": {
  "collection": "weeks",
  "class": "Derived",
  "writers": [
   "weekly"
  ],
  "schema": 4,
  "authored": [
   "review",
   "reflection"
  ]
 },
 "$comment": "Shape completed with the weekly pipeline (B-09).",
 "type": "object",
 "properties": {
  "schema": {
   "const": 4
  },
  "writer": {
   "enum": [
    "weekly"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "review": {
   "type": "string"
  },
  "reflection": {
   "type": "string"
  },
  "calibration": {
   "type": "object"
  },
  "health": {
   "type": "object",
   "description": "schema 2 (B-29): the week's run line, and the read-only verify-deploy the weekly ran on its own record",
   "required": [
    "summary"
   ],
   "properties": {
    "summary": {
     "type": "string"
    },
    "verify": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "at",
        "target",
        "green"
       ],
       "properties": {
        "at": {
         "type": "string"
        },
        "target": {
         "enum": [
          "live",
          "staging"
         ]
        },
        "commit": {
         "type": [
          "string",
          "null"
         ]
        },
        "green": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "checked": {
         "type": "integer",
         "minimum": 0
        },
        "differences": {
         "type": "array",
         "maxItems": 30,
         "items": {
          "type": "object",
          "required": [
           "what"
          ],
          "properties": {
           "what": {
            "type": "string"
           },
           "detail": {
            "type": "string"
           }
          }
         }
        },
        "refused": {
         "type": "string"
        }
       }
      }
     ]
    },
    "evidence": {
     "type": "object",
     "description": "B-165 (D-188): the evidence B-70 and B-71 wait on, counted by the weekly: every answer in the record, and the exams that carry both a prediction and a score",
     "required": [
      "answers",
      "scoredExams"
     ],
     "properties": {
      "answers": {
       "type": "integer",
       "minimum": 0
      },
      "scoredExams": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "recap": {
     "type": "string",
     "maxLength": 200,
     "description": "B-201: the build recap, one sentence from the Chart on origin/main: what shipped to live this week and how many tasks wait on Matt"
    }
   }
  },
  "rollups": {
   "type": "object",
   "properties": {
    "readiness": {
     "description": "B-48 (D-105): readiness per upcoming exam of every active course as of this document (percent solid, active and solid weak spots, accuracy over the last seven days); null on a document written before it",
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "properties": {
         "pctSolid": {
          "anyOf": [
           {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
           },
           {
            "type": "null"
           }
          ]
         },
         "active": {
          "type": "integer",
          "minimum": 0
         },
         "solid": {
          "type": "integer",
          "minimum": 0
         },
         "accuracy7": {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0,
            "maximum": 100
           },
           {
            "type": "null"
           }
          ]
         },
         "answers7": {
          "type": "integer",
          "minimum": 0
         }
        },
        "required": [
         "pctSolid",
         "active",
         "solid",
         "accuracy7",
         "answers7"
        ],
        "additionalProperties": false
       }
      }
     ]
    }
   }
  },
  "study": {
   "type": "object",
   "description": "B-68 (D-116): the week's list and shadow compared (core/study.mjs compareWeek); absent before the shadow existed"
  },
  "insights": {
   "description": "B-72 (D-120): the week's measurements, computed by the weekly (accuracy by objective, format and clinical-judgment step over 28 days, items missed every time, recurrence leaders, study minutes against next-day accuracy, the weakest objective and three lines); null on a week written before them",
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "window": {
       "type": "object",
       "properties": {
        "from": {
         "type": "string",
         "format": "date"
        },
        "to": {
         "type": "string",
         "format": "date"
        }
       },
       "required": [
        "from",
        "to"
       ],
       "additionalProperties": false
      },
      "byObjective": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "right": {
          "type": "integer",
          "minimum": 0
         },
         "n": {
          "type": "integer",
          "minimum": 1
         },
         "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
         }
        },
        "required": [
         "id",
         "right",
         "n",
         "pct"
        ],
        "additionalProperties": false
       }
      },
      "byFormat": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "right": {
          "type": "integer",
          "minimum": 0
         },
         "n": {
          "type": "integer",
          "minimum": 1
         },
         "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
         }
        },
        "required": [
         "id",
         "right",
         "n",
         "pct"
        ],
        "additionalProperties": false
       }
      },
      "byCjStep": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "right": {
          "type": "integer",
          "minimum": 0
         },
         "n": {
          "type": "integer",
          "minimum": 1
         },
         "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
         }
        },
        "required": [
         "id",
         "right",
         "n",
         "pct"
        ],
        "additionalProperties": false
       }
      },
      "missedEvery": {
       "type": "array",
       "maxItems": 5,
       "items": {
        "type": "object",
        "properties": {
         "ref": {
          "type": "string",
          "minLength": 1
         },
         "topic": {
          "type": [
           "string",
           "null"
          ]
         },
         "objective": {
          "type": [
           "string",
           "null"
          ]
         },
         "attempts": {
          "type": "integer",
          "minimum": 2
         },
         "missed": {
          "type": "integer",
          "minimum": 2
         }
        },
        "required": [
         "ref",
         "attempts",
         "missed"
        ],
        "additionalProperties": false
       }
      },
      "neverMissed": {
       "type": "integer",
       "minimum": 0
      },
      "recurrence": {
       "type": "array",
       "maxItems": 5,
       "items": {
        "type": "object",
        "properties": {
         "weakspotId": {
          "type": "string",
          "minLength": 1
         },
         "topic": {
          "type": "string"
         },
         "recurrence": {
          "type": "integer",
          "minimum": 2
         }
        },
        "required": [
         "weakspotId",
         "topic",
         "recurrence"
        ],
        "additionalProperties": false
       }
      },
      "studyVsNextDay": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "date": {
          "type": "string",
          "format": "date"
         },
         "minutes": {
          "type": "number",
          "minimum": 0
         },
         "energy": {
          "type": [
           "integer",
           "null"
          ]
         },
         "nextAnswers": {
          "type": [
           "integer",
           "null"
          ]
         },
         "nextPct": {
          "type": [
           "integer",
           "null"
          ]
         }
        },
        "required": [
         "date",
         "minutes",
         "energy",
         "nextAnswers",
         "nextPct"
        ],
        "additionalProperties": false
       }
      },
      "weakestObjective": {
       "type": [
        "string",
        "null"
       ]
      },
      "lines": {
       "type": "array",
       "maxItems": 3,
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "required": [
      "window",
      "byObjective",
      "byFormat",
      "byCjStep",
      "missedEvery",
      "neverMissed",
      "recurrence",
      "studyVsNextDay",
      "weakestObjective",
      "lines"
     ],
     "additionalProperties": false
    }
   ]
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "date",
  "insights"
 ]
}