{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/plans",
 "title": "plans/<id>",
 "description": "cards, days, tasks",
 "x-ev": {
  "collection": "plans",
  "class": "Fact",
  "writers": [
   "worker",
   "page"
  ],
  "schema": 1
 },
 "$comment": "Task ticks live in planedits/<exam id>.",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "writer": {
   "enum": [
    "worker",
    "page"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "exam": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string"
  },
  "sourceUrl": {
   "type": "string"
  },
  "cards": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "tasks": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "days": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "date": {
      "type": "string",
      "format": "date"
     },
     "label": {
      "type": "string"
     },
     "tasks": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "text": {
         "type": "string"
        },
        "tag": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "chapters": {
         "type": "array",
         "items": {
          "type": [
           "string",
           "integer"
          ]
         }
        },
        "minutes": {
         "type": "integer"
        },
        "doneWhen": {
         "type": "string"
        },
        "ref": {
         "type": "string"
        }
       },
       "required": [
        "id"
       ]
      }
     }
    },
    "required": [
     "date"
    ]
   }
  },
  "section": {
   "type": "object",
   "required": [
    "course",
    "from",
    "to"
   ]
  },
  "scope": {
   "type": "array"
  },
  "keyDates": {
   "type": "array"
  },
  "openQuestions": {
   "type": "array"
  },
  "score": {
   "type": "object",
   "required": [
    "criteria",
    "total"
   ]
  },
  "instructions": {
   "enum": [
    "settings",
    "default"
   ],
   "description": "B-449: whose instructions the plan followed"
  },
  "revises": {
   "type": "string",
   "description": "B-449: the plans/<id> this draft revises"
  },
  "editedSinceScore": {
   "type": "boolean",
   "description": "D-356: an edit changed the plan after the model scored it; score is the baseline"
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "exam"
 ],
 "not": {
  "anyOf": [
   {
    "required": [
     "done"
    ]
   }
  ]
 }
}