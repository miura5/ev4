{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/state",
 "title": "state/<id>",
 "description": "the snapshot and the derived hash",
 "x-ev": {
  "collection": "state",
  "class": "Derived",
  "writers": [
   "evening-cloud",
   "morning"
  ],
  "schema": 1
 },
 "$comment": "Shape completed with evening-cloud (B-09).",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "writer": {
   "enum": [
    "evening-cloud",
    "morning"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "snapshot": {
   "type": "object"
  },
  "derivedHash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "factHashes": {
   "type": "object"
  },
  "factFields": {
   "type": "object",
   "description": "B-32: per collection, the sorted fields the fact hashes' masks index (marks, append maps and at left out)",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "factsSplit": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "B-37 (D-093): the collections whose fact hashes live in state/facts-<collection>, because state/current reached its warnBytes"
  },
  "facts": {
   "type": "string",
   "description": "B-37: on state/facts-<collection>, the collection whose fact hashes it holds"
  },
  "lint": {
   "type": "object",
   "description": "D-090: the record lint evening-cloud ran on its pull (lintSummary): counts, every error and warning up to 20, notes by code; the System tab Checks card shows it",
   "required": [
    "at",
    "errors",
    "warnings",
    "notes",
    "top"
   ],
   "properties": {
    "at": {
     "type": "string"
    },
    "commit": {
     "type": [
      "string",
      "null"
     ]
    },
    "errors": {
     "type": "integer",
     "minimum": 0
    },
    "warnings": {
     "type": "integer",
     "minimum": 0
    },
    "notes": {
     "type": "integer",
     "minimum": 0
    },
    "notesByCode": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     }
    },
    "rebuilt": {
     "type": "object",
     "properties": {
      "same": {
       "type": "integer",
       "minimum": 0
      },
      "of": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "top": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "object",
      "required": [
       "severity",
       "code",
       "ref",
       "msg"
      ],
      "properties": {
       "severity": {
        "enum": [
         "error",
         "warning"
        ]
       },
       "code": {
        "type": "string"
       },
       "ref": {
        "type": "string"
       },
       "msg": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source"
 ]
}