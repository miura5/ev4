{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/sets",
 "title": "sets/<id>",
 "description": "items, kind, date, exam; items never change once written",
 "x-ev": {
  "collection": "sets",
  "class": "Fact",
  "writers": [
   "morning",
   "worker",
   "page"
  ],
  "schema": 2
 },
 "$comment": "Items never change once written; answers live in answers/<setId>.",
 "type": "object",
 "properties": {
  "schema": {
   "const": 2
  },
  "writer": {
   "enum": [
    "morning",
    "worker",
    "page"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "enum": [
    "review",
    "drill",
    "sim",
    "more",
    "job"
   ]
  },
  "title": {
   "type": "string"
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "exam": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "planTaskId": {
   "type": "string"
  },
  "objectives": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "focus": {
   "type": [
    "string",
    "array",
    "null"
   ]
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "type": "string"
     },
     "type": {
      "enum": [
       "single",
       "sata",
       "matrix",
       "numeric"
      ]
     },
     "stem": {
      "type": "string",
      "minLength": 10
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "maxItems": 6
     },
     "correct": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0
      },
      "minItems": 1
     },
     "rationales": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "matrix": {
      "type": "object",
      "properties": {
       "columns": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 2,
        "maxItems": 4
       },
       "rows": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1
          },
          "correct": {
           "type": "integer",
           "minimum": 0
          },
          "rationale": {
           "type": "string"
          }
         },
         "required": [
          "text",
          "correct"
         ],
         "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 6
       }
      },
      "required": [
       "columns",
       "rows"
      ],
      "additionalProperties": false
     },
     "answer": {
      "type": "number",
      "description": "B-43 (D-100): a numeric item's answer"
     },
     "unit": {
      "type": "string",
      "minLength": 1,
      "description": "B-43: one of spec.items.units"
     },
     "tolerance": {
      "type": "number",
      "minimum": 0,
      "description": "B-43: absolute; the rounding the stem states"
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1,
      "maxItems": 12,
      "description": "B-43: the worked solution, shown after answering"
     },
     "weakspotId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "topic": {
      "type": "string"
     },
     "cjStep": {
      "type": "string"
     },
     "verify": {
      "type": "boolean"
     },
     "sourceRef": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^materials/"
       },
       {
        "type": "null"
       }
      ]
     },
     "chapters": {
      "anyOf": [
       {
        "type": "array",
        "items": {
         "type": [
          "string",
          "integer"
         ]
        }
       },
       {
        "type": "string"
       }
      ]
     }
    },
    "required": [
     "id",
     "stem"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "createdAt": {
   "type": "string",
   "format": "date-time"
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "kind",
  "items"
 ],
 "not": {
  "anyOf": [
   {
    "required": [
     "answers"
    ]
   },
   {
    "required": [
     "pastAttempts"
    ]
   }
  ]
 }
}