{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/days",
 "title": "days/<id>",
 "description": "dayType, plan, list, push",
 "x-ev": {
  "collection": "days",
  "class": "Derived",
  "writers": [
   "morning"
  ],
  "schema": 2
 },
 "type": "object",
 "properties": {
  "schema": {
   "const": 2
  },
  "writer": {
   "enum": [
    "morning"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "dayType": {
   "type": "string"
  },
  "plan": {
   "type": [
    "object",
    "null"
   ]
  },
  "list": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "text": {
        "type": "string"
       }
      },
      "required": [
       "id"
      ]
     }
    },
    "focus": {
     "type": "array"
    },
    "push": {
     "type": "string"
    },
    "budget": {
     "type": [
      "object",
      "null"
     ]
    },
    "deferred": {
     "type": "array"
    }
   },
   "required": [
    "items"
   ]
  },
  "push": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "shadow": {
   "description": "B-68 (D-116): the other scheduler's pick for the day (spec.study.scheduler drives the list); null on a day written before it",
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "scheduler": {
       "enum": [
        "fixed",
        "adaptive"
       ]
      },
      "ids": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "deferred": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "scheduler",
      "ids",
      "deferred"
     ],
     "additionalProperties": false
    }
   ]
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "date",
  "list",
  "shadow"
 ],
 "additionalProperties": false
}