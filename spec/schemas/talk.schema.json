{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/talk",
 "title": "talk/<id>",
 "description": "messages map, keys m-<time>-<by>",
 "x-ev": {
  "collection": "talk",
  "class": "Fact",
  "writers": [
   "page",
   "worker",
   "builder"
  ],
  "schema": 4,
  "documents": {
   "memory": "#/$defs/memory"
  }
 },
 "$comment": "talk/<date> is a Fact of appended messages; talk/memory is Derived (its own shape).",
 "type": "object",
 "properties": {
  "schema": {
   "const": 4
  },
  "writer": {
   "enum": [
    "page",
    "worker",
    "builder"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "messages": {
   "type": "object",
   "propertyNames": {
    "pattern": "^m-\\d{8}-\\d{6}(\\d{3})?-[a-z]+$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "role": {
      "enum": [
       "ev",
       "matt"
      ]
     },
     "text": {
      "type": "string",
      "maxLength": 4000
     },
     "cards": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "maxItems": 3
     },
     "at": {
      "type": "string",
      "format": "date-time"
     },
     "tier": {
      "enum": [
       "quick",
       "default",
       "complex",
       "local"
      ]
     },
     "replyTo": {
      "type": "string"
     },
     "jobId": {
      "type": "string"
     },
     "error": {
      "type": "string"
     },
     "session": {
      "type": "string",
      "pattern": "^ss-[A-Za-z0-9-]+$",
      "description": "B-74 (D-128): the study session the message was written during"
     },
     "note": {
      "type": "object",
      "description": "B-74 (D-130, D-131): the note line a comment is about",
      "properties": {
       "file": {
        "type": "string",
        "maxLength": 300
       },
       "title": {
        "type": "string",
        "maxLength": 200
       },
       "line": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 1
       },
       "quote": {
        "type": "string",
        "maxLength": 90
       }
      },
      "required": [
       "file",
       "title",
       "line",
       "quote"
      ],
      "additionalProperties": false
     },
     "work": {
      "type": "object",
      "description": "B-227 (D-232): her work line: how long the reply took (ms, from his send to her line) and the documents it changed (<collection>/<id>, each opening its place on the page)",
      "properties": {
       "ms": {
        "type": "integer",
        "minimum": 0
       },
       "changed": {
        "type": "array",
        "maxItems": 10,
        "items": {
         "type": "string",
         "pattern": "^[a-z]+/.+"
        }
       }
      },
      "required": [
       "ms",
       "changed"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "role",
     "text",
     "at"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "date",
  "messages"
 ],
 "additionalProperties": false,
 "$defs": {
  "memory": {
   "type": "object",
   "properties": {
    "schema": {
     "const": 4
    },
    "writer": {
     "const": "page"
    },
    "at": {
     "type": "string",
     "format": "date-time"
    },
    "source": {
     "type": "string",
     "minLength": 1
    },
    "summary": {
     "type": "string",
     "maxLength": 1200
    },
    "upTo": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "summarizedAt": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "lastSeenAt": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "headlines": {
     "type": "array",
     "maxItems": 7,
     "description": "B-129 (D-167): the last 7 greeting headlines he saw, newest last, so the next one does not repeat them",
     "items": {
      "type": "object",
      "properties": {
       "at": {
        "type": "string",
        "format": "date-time"
       },
       "text": {
        "type": "string",
        "maxLength": 240
       },
       "by": {
        "enum": [
         "model",
         "code"
        ]
       }
      },
      "required": [
       "at",
       "text"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "schema",
    "writer",
    "at",
    "source",
    "summary"
   ],
   "additionalProperties": false,
   "description": "talk/memory, an Edit of the page (D-096): the running summary, replaced whole; never rebuilt"
  }
 }
}