{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ev4/weakspots",
 "title": "weakspots/<id>",
 "description": "topic, objective, exam, course, kind, source, initial, events map; schema 2 (D-236, D-240): proposed, words, links",
 "x-ev": {
  "collection": "weakspots",
  "class": "Fact",
  "writers": [
   "page",
   "morning",
   "worker",
   "filing"
  ],
  "schema": 2,
  "marks": {
   "links": [
    "page"
   ]
  }
 },
 "$comment": "Nothing derived on a Fact: state comes from answers and events by the core function. Schema 2 (B-232): proposed marks a spot she inferred (D-235, D-237), counted nowhere until his accept, join, snooze or decline; words keeps his words or the item's stem under her topic (D-239); links is the ideas link shape plus duplicate-of (D-240). Schema 1 stays valid until the 1 to 2 migration runs (a spot written before it, with none of schema 2's fields or events), so a release can land before its migration; every writer writes 2.",
 "type": "object",
 "properties": {
  "schema": {
   "enum": [
    1,
    2
   ]
  },
  "writer": {
   "enum": [
    "page",
    "morning",
    "worker",
    "filing"
   ]
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "topic": {
   "type": "string",
   "minLength": 1
  },
  "words": {
   "type": "string"
  },
  "objective": {
   "type": "string"
  },
  "exam": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "course": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "concept",
    "note",
    "connection",
    "format",
    "skill"
   ]
  },
  "proposed": {
   "type": "boolean"
  },
  "addedBy": {
   "type": "string"
  },
  "origin": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "set": {
       "type": [
        "string",
        "null"
       ]
      },
      "item": {
       "type": [
        "string",
        "null"
       ]
      },
      "session": {
       "type": "string"
      },
      "at": {
       "type": "string",
       "format": "date-time"
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "preRead": {
   "type": "boolean"
  },
  "readingDue": {
   "anyOf": [
    {
     "type": "string",
     "format": "date"
    },
    {
     "type": "null"
    }
   ]
  },
  "initial": {
   "type": "object",
   "properties": {
    "streak": {
     "type": "integer",
     "minimum": 0
    },
    "nextDue": {
     "anyOf": [
      {
       "type": "string",
       "format": "date"
      },
      {
       "type": "null"
      }
     ]
    },
    "recurrence": {
     "type": "integer",
     "minimum": 0
    },
    "misses": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [],
   "additionalProperties": false
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "to": {
      "type": "string",
      "pattern": "^[a-z]+/.+"
     },
     "type": {
      "enum": [
       "seen-in",
       "related",
       "contrasts",
       "causes",
       "duplicate-of"
      ]
     },
     "note": {
      "type": "string"
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     },
     "createdBy": {
      "type": "string"
     }
    },
    "required": [
     "to",
     "type"
    ],
    "additionalProperties": false
   }
  },
  "events": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z][a-z-]*-\\d{8}-\\d{6}(\\d{3})?(-[a-z0-9]+)?$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "type": {
      "enum": [
       "park",
       "activate",
       "solid",
       "done",
       "move",
       "seen",
       "reopen",
       "accept",
       "snooze",
       "decline"
      ]
     },
     "by": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "at": {
      "type": "string",
      "format": "date-time"
     },
     "objective": {
      "type": "string"
     },
     "until": {
      "type": "string",
      "format": "date"
     }
    },
    "required": [
     "type"
    ],
    "additionalProperties": false,
    "anyOf": [
     {
      "properties": {
       "type": {
        "not": {
         "const": "snooze"
        }
       }
      }
     },
     {
      "required": [
       "until"
      ]
     }
    ]
   }
  }
 },
 "required": [
  "schema",
  "writer",
  "at",
  "source",
  "topic",
  "objective",
  "kind",
  "initial",
  "events"
 ],
 "not": {
  "anyOf": [
   {
    "required": [
     "derived"
    ]
   },
   {
    "required": [
     "concept"
    ]
   }
  ]
 },
 "anyOf": [
  {
   "properties": {
    "schema": {
     "const": 2
    }
   }
  },
  {
   "properties": {
    "schema": {
     "const": 1
    },
    "events": {
     "additionalProperties": {
      "properties": {
       "type": {
        "not": {
         "enum": [
          "accept",
          "snooze",
          "decline"
         ]
        }
       }
      }
     }
    }
   },
   "not": {
    "anyOf": [
     {
      "required": [
       "proposed"
      ]
     },
     {
      "required": [
       "words"
      ]
     },
     {
      "required": [
       "links"
      ]
     }
    ]
   }
  }
 ]
}