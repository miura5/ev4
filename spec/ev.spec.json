{
 "specVersion": "4.0.0",
 "purpose": "E.V. v4's machine-readable spec: collections, tasks, environments, capacity, boundaries and working agreements. Pipelines, build chats and the page read this instead of prose; the design is the E.V. Foundation v4 doc.",
 "roles": [
  "page",
  "morning",
  "evening-cloud",
  "evening-mac",
  "weekly",
  "worker",
  "watchdog",
  "canvas-sync",
  "filing",
  "deploy",
  "restore-drill",
  "diagnostic"
 ],
 "pipelines": [
  "morning",
  "evening-cloud",
  "evening-mac",
  "weekly",
  "worker",
  "watchdog",
  "restore-drill",
  "diagnostic"
 ],
 "classes": {
  "Fact": "Created once by one writer; append-only maps gain keys namespaced <writer>-<time>, never changed or removed. The truth.",
  "Edit": "The page only; replaced whole, small, one document per day or entity; sits beside a Fact and overrides nothing in it.",
  "Derived": "One named producer (refreshers listed after it); rebuilt from Facts and Edits; rebuild reproduces it byte for byte.",
  "Log": "Written at start, finished at end, then immutable.",
  "Config": "Deploy only; replaced whole from the manifest."
 },
 "constants": {
  "_rules": [
   "The constants E.V. core reads (configure(spec)), ported from v3. Tuned with Matt over time; a change needs a Changelog line."
  ],
  "review": {
   "solidAfterRightDays": 2,
   "intervalDays": 3,
   "intervalNearExamDays": 1,
   "nearExamWithinDays": 5,
   "load": {
    "class": 10,
    "off": 10,
    "validation": 10,
    "clinical": 3,
    "clinicalBeforeExam": 5,
    "examDay": 0
   },
   "flex": {
    "withinDays": 3,
    "max": 15,
    "maxClinical": 8
   },
   "newChecksPerDay": 3,
   "newChecksOn": [
    "class",
    "off"
   ],
   "minutesPerQuestion": 1.5
  },
  "dayBudgetMinutes": {
   "_note": "Starting defaults, tuned with Matt over time. The planner never cuts graded work, exams, clinical or validations.",
   "off": 300,
   "class": 180,
   "validation": 150,
   "clinical": 60,
   "exam": 120
  },
  "taskMinutes": {
   "reading": 45,
   "drill": 25,
   "sim": 75,
   "review": 20,
   "val": 20,
   "terminology": 15,
   "graded": 45,
   "clinical": 0,
   "exam": 90,
   "other": 20
  },
  "studyWatch": {
   "checkMinutes": 7,
   "itemsPerCheck": [
    1,
    3
   ],
   "idleChecksToEnd": 3,
   "extendMinutes": 5,
   "minResumeSeconds": 30,
   "takeoverMinutes": 2,
   "openingChars": 800,
   "addedChars": 6000,
   "fallbackChars": 2500
  },
  "nurUnitExamKinds": [
   "unit",
   "final",
   "dosage"
  ],
  "library": {
   "chunkChars": 900,
   "searchK": 6,
   "hitChars": 700,
   "readChars": 12000,
   "maxChars": 200000,
   "ocrMinChars": 80,
   "pdfjs": "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs",
   "pdfjsWorker": "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.worker.min.mjs"
  }
 },
 "registry": {
  "records": {
   "live": {
    "artifact": "Bu8RevP4r1twPdSGc77nfg",
    "name": "E.V. Home"
   },
   "staging": {
    "artifact": "Pb6jQ6CvEbtxi6Rcshu9uC",
    "name": "E.V. Home Staging v4"
   }
  },
  "docs": {
   "designV4": "Fgb2KjoLKcRgCRrBmM6kEf",
   "v3": "AXwVp9xqpWaUKLE4SqZzwg"
  },
  "repos": {
   "v4": "miura5/ev4",
   "v3": "miura5/ev-core"
  }
 },
 "collections": {
  "weakspots": {
   "class": "Fact",
   "writers": [
    "page",
    "morning",
    "worker",
    "filing"
   ],
   "key": "ws-<date>-<objective>-<slug>",
   "holds": "topic, objective, exam, course, kind, source, initial, events map",
   "fromV3": "weakspots minus derived",
   "appends": {
    "events": [
     "page",
     "evening-cloud",
     "filing"
    ]
   },
   "schema": "spec/schemas/weakspots.schema.json"
  },
  "sets": {
   "class": "Fact",
   "writers": [
    "morning",
    "worker",
    "page"
   ],
   "key": [
    "review-<date>",
    "<exam>-drill-<n>",
    "more-<date>-<n>",
    "job sets"
   ],
   "holds": "items, kind, date, exam; items never change once written",
   "fromV3": "sets minus answers",
   "schema": "spec/schemas/sets.schema.json"
  },
  "answers": {
   "class": "Fact",
   "writers": [
    "page"
   ],
   "key": "<setId>",
   "holds": "answers map, item id to attempts (append-only)",
   "fromV3": "sets.answers, sets.pastAttempts",
   "appends": {
    "answers": [
     "page"
    ]
   },
   "schema": "spec/schemas/answers.schema.json"
  },
  "exams": {
   "class": "Fact",
   "writers": [
    "canvas-sync",
    "page",
    "worker"
   ],
   "key": [
    "E1…E6",
    "BIO-E3",
    "ATI-*"
   ],
   "holds": "title, date, course, kind, status",
   "fromV3": "exams",
   "schema": "spec/schemas/exams.schema.json"
  },
  "objectives": {
   "class": "Fact",
   "writers": [
    "worker",
    "page"
   ],
   "key": "<exam>-<n>",
   "holds": "text, exam (seeded, never invented)",
   "fromV3": "objectives",
   "schema": "spec/schemas/objectives.schema.json"
  },
  "plans": {
   "class": "Fact",
   "writers": [
    "worker",
    "page"
   ],
   "key": "<exam id>",
   "holds": "cards, days, tasks",
   "fromV3": "plans minus done",
   "schema": "spec/schemas/plans.schema.json"
  },
  "planedits": {
   "class": "Edit",
   "writers": [
    "page"
   ],
   "key": "<exam id>",
   "holds": "task ticks",
   "fromV3": "plans.done",
   "schema": "spec/schemas/planedits.schema.json"
  },
  "dates": {
   "class": "Fact",
   "writers": [
    "canvas-sync",
    "page"
   ],
   "key": [
    "canvas-<id>",
    "<date>-<slug>"
   ],
   "holds": "the calendar entry",
   "fromV3": "dates",
   "schema": "spec/schemas/dates.schema.json"
  },
  "dateedits": {
   "class": "Edit",
   "writers": [
    "page"
   ],
   "key": "<the date's id>",
   "holds": "removed, notes, field overrides",
   "fromV3": "dates.removed, .notes, .edited*",
   "schema": "spec/schemas/dateedits.schema.json"
  },
  "days": {
   "class": "Derived",
   "writers": [
    "morning"
   ],
   "key": "YYYY-MM-DD",
   "holds": "dayType, plan, list, push",
   "fromV3": "days.plan, .list, .push",
   "rebuild": "rebuild days",
   "schema": "spec/schemas/days.schema.json"
  },
  "dayedits": {
   "class": "Edit",
   "writers": [
    "page"
   ],
   "key": "YYYY-MM-DD",
   "holds": "checks, added, skipped, checkin",
   "fromV3": "days.checks, .added, .skipped, .checkin",
   "schema": "spec/schemas/dayedits.schema.json"
  },
  "weeks": {
   "class": "Derived",
   "writers": [
    "weekly"
   ],
   "key": "<Sunday's date>",
   "holds": "review text, reflection prompt, calibration, health line, roll-ups",
   "fromV3": "days.weekly",
   "rebuild": "rebuild weeks",
   "schema": "spec/schemas/weeks.schema.json"
  },
  "runs": {
   "class": "Log",
   "writers": [
    "morning",
    "evening-cloud",
    "evening-mac",
    "weekly",
    "worker",
    "watchdog",
    "restore-drill",
    "diagnostic"
   ],
   "key": "<pipeline>-<YYYYMMDD-HHMMSS>-<4>",
   "holds": "pipeline, release, startedAt, endedAt, status, steps, detail",
   "fromV3": "days.runs",
   "schema": "spec/schemas/runs.schema.json"
  },
  "health": {
   "class": "Derived",
   "writers": [
    "watchdog",
    "evening-cloud",
    "restore-drill"
   ],
   "key": "current",
   "holds": "last run per pipeline, stalled jobs, drift result, capacity, restore-drill age",
   "fromV3": "new",
   "fixedIds": [
    "current"
   ],
   "rebuild": "rebuild health",
   "schema": "spec/schemas/health.schema.json"
  },
  "state": {
   "class": "Derived",
   "writers": [
    "evening-cloud",
    "morning"
   ],
   "key": "current",
   "holds": "the snapshot and the derived hash",
   "fromV3": "state",
   "fixedIds": [
    "current"
   ],
   "rebuild": "rebuild state",
   "schema": "spec/schemas/state.schema.json"
  },
  "sessions": {
   "class": "Fact",
   "writers": [
    "page",
    "filing"
   ],
   "key": [
    "ss-*",
    "sw-*"
   ],
   "holds": "events map, findings, lengths and hashes, never note text",
   "fromV3": "sessions",
   "appends": {
    "events": [
     "page"
    ]
   },
   "schema": "spec/schemas/sessions.schema.json"
  },
  "ideas": {
   "class": "Fact",
   "writers": [
    "page",
    "filing"
   ],
   "key": "<slug>",
   "holds": "text, objective, links, status mark",
   "fromV3": "ideas",
   "schema": "spec/schemas/ideas.schema.json"
  },
  "journal": {
   "class": "Fact",
   "writers": [
    "page"
   ],
   "key": "auto",
   "holds": "entries; pipelines never read; not in backups",
   "fromV3": "journal",
   "private": true,
   "schema": "spec/schemas/journal.schema.json"
  },
  "talk": {
   "class": "Fact",
   "writers": [
    "page",
    "worker"
   ],
   "key": "YYYY-MM-DD",
   "holds": "messages map, keys m-<time>-<by>",
   "fromV3": "talk",
   "appends": {
    "messages": [
     "page",
     "worker"
    ]
   },
   "documents": {
    "memory": {
     "class": "Derived",
     "writers": [
      "page"
     ],
     "holds": "the running summary",
     "fromV3": "talk/memory",
     "rebuild": "rebuild talk/memory"
    }
   },
   "schema": "spec/schemas/talk.schema.json"
  },
  "jobs": {
   "class": "Fact",
   "writers": [
    "page"
   ],
   "key": "job-<YYYYMMDD-HHMMSS>-<slug>",
   "holds": "kind, title, brief, fired",
   "fromV3": "jobs request fields",
   "schema": "spec/schemas/jobs.schema.json"
  },
  "jobresults": {
   "class": "Log",
   "writers": [
    "worker"
   ],
   "key": "<the job id>",
   "holds": "status, result, posted message key",
   "fromV3": "jobs status and result fields",
   "schema": "spec/schemas/jobresults.schema.json"
  },
  "materials": {
   "class": "Fact",
   "writers": [
    "canvas-sync",
    "page"
   ],
   "key": [
    "<COURSE>-<fileId>",
    "up-*"
   ],
   "holds": "text with page marks, ocr, kind, module",
   "fromV3": "materials",
   "schema": "spec/schemas/materials.schema.json"
  },
  "materialedits": {
   "class": "Edit",
   "writers": [
    "page"
   ],
   "key": "<the material's id>",
   "holds": "removed",
   "fromV3": "materials.status",
   "schema": "spec/schemas/materialedits.schema.json"
  },
  "libindex": {
   "class": "Derived",
   "writers": [
    "evening-cloud"
   ],
   "key": "<course>",
   "holds": "the chunk index the page searches",
   "fromV3": "new (built on the page in v3)",
   "rebuild": "rebuild libindex",
   "schema": "spec/schemas/libindex.schema.json"
  },
  "announcements": {
   "class": "Fact",
   "writers": [
    "canvas-sync"
   ],
   "key": "canvas-<id>",
   "holds": "plain text, course, postedAt",
   "fromV3": "announcements",
   "schema": "spec/schemas/announcements.schema.json"
  },
  "concepts": {
   "class": "Derived",
   "writers": [
    "weekly"
   ],
   "key": "<slug>",
   "holds": "weak spots grouped under one concept",
   "fromV3": "concepts (never populated)",
   "rebuild": "rebuild concepts",
   "schema": "spec/schemas/concepts.schema.json"
  },
  "system": {
   "class": "Config",
   "writers": [
    "deploy"
   ],
   "key": [
    "spec",
    "manifest",
    "environments",
    "seed"
   ],
   "holds": "the spec; the release pointer; proven capabilities; the staging seed stamp",
   "fromV3": "system/spec, system/code",
   "fixedIds": [
    "spec",
    "manifest",
    "environments",
    "seed"
   ],
   "schema": "spec/schemas/system.schema.json"
  },
  "legacy": {
   "class": "Fact",
   "writers": [],
   "key": "as written",
   "holds": "v2 and v3 documents marked migratedTo",
   "fromV3": "legacy plus v3 originals at cutover",
   "frozen": true,
   "schema": "spec/schemas/legacy.schema.json"
  }
 },
