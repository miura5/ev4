{
 "name": "ev4",
 "version": "0.0.0",
 "private": true,
 "description": "E.V. v4: Matt's study partner. Engine, page and pipelines; no personal data.",
 "type": "module",
 "engines": {
  "node": ">=22"
 },
 "scripts": {
  "test": "node --import ./test/tmp-root.mjs --test $TEST_REPORTERS test/*.test.mjs",
  "build": "node tools/build.mjs",
  "check": "node tools/check.mjs",
  "smoke": "node tools/build.mjs && node test/smoke-keys.cjs synthetic && node test/harness/smoke.cjs synthetic",
  "format": "prettier --write . && node tools/format-app.mjs",
  "smoke:pwa": "node pwa/smoke.mjs",
  "test:run-api": "node --test pwa/run-api.test.mjs"
 },
 "devDependencies": {
  "playwright": "1.64.1",
  "prettier": "3.9.10"
 }
}
